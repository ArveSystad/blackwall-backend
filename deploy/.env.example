# Copy to deploy/.env and fill in. deploy/.env is gitignored.

# Password for the blackwall database role. Generate with `openssl rand -hex 32`;
# URL-safe characters only, it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Address the service is published on. Keep 127.0.0.1 when the reverse proxy runs
# on this host; change it only if the proxy runs elsewhere and the port is firewalled.
SYNC_BIND_ADDR=127.0.0.1

# Host port the reverse proxy forwards to.
SYNC_PORT=8080

# Days to keep dumps in deploy/backups/ before pruning them.
BACKUP_RETENTION_DAYS=14

# Seconds between dumps (86400 = daily). The first dump runs when the stack starts.
BACKUP_INTERVAL_SECONDS=86400
