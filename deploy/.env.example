# Copy to deploy/.env and fill in. deploy/.env is gitignored.

# Connection string for the external PostgreSQL 17 database. The role must be able
# to create tables in this database: the service runs its migrations on startup.
# Percent-encode URL-reserved characters in the password. For a TLS connection to
# a remote database, append ?sslmode=require (or verify-full to check the certificate).
DATABASE_URL=postgres://blackwall:change-me@db.example.internal:5432/blackwall?sslmode=require

# Address the service is published on. Keep 127.0.0.1 when the reverse proxy runs
# on this host; change it only if the proxy runs elsewhere and the port is firewalled.
SYNC_BIND_ADDR=127.0.0.1

# Host port the reverse proxy forwards to.
SYNC_PORT=8080
